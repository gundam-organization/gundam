# Doxygen configuration for GUNDAM.
# Run from this folder:  doxygen Doxyfile   ->  build/html/index.html
# Currently covers src/DialDictionary. Add more src/ folders to INPUT as they
# are documented (or use ../../src to take everything).

PROJECT_NAME           = "GUNDAM"
PROJECT_BRIEF          = "Generalized and Unified Neutrino Data Analysis Methods"
OUTPUT_DIRECTORY       = build
CREATE_SUBDIRS         = NO

# --- What to read ------------------------------------------------------------
INPUT                  = groups.dox \
                         ../../src/DialDictionary
FILE_PATTERNS          = *.h *.cpp *.cxx *.dox
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */hemi/* *LinkDef*.h
STRIP_FROM_PATH        = ../../src
STRIP_FROM_INC_PATH    = ../../src/DialDictionary/DialEngine/include \
                         ../../src/DialDictionary/DialDefinitions/include \
                         ../../src/DialDictionary/DialFactories/include

# --- How to read the comments ------------------------------------------------
# GUNDAM uses "///" blocks. With this on, the first sentence of a "///" block
# becomes the brief description, so no @brief is needed on members.
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = NO
MARKDOWN_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
INHERIT_DOCS           = YES

# --- Preprocessor: hide the macro-generated enum helpers ----------------------
ENABLE_PREPROCESSING   = YES
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = stubs
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = "MAKE_ENUM_JSON_INTERFACE(x)="
EXCLUDE_SYMBOLS        = MAKE_ENUM_JSON_INTERFACE

# --- What to show ------------------------------------------------------------
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
SORT_MEMBER_DOCS       = NO

# --- Warnings: report anything left undocumented ------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_LOGFILE           = build/doxygen-warnings.log

# --- Output ------------------------------------------------------------------
GENERATE_HTML          = YES
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
HAVE_DOT               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = NO
