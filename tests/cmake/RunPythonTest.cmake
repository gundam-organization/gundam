# Runs under CMake so a missing configure-time Python cannot prevent fallback.
include("${TEST_CONFIG}")
set(ENV{PYTHONPATH} "${testPythonModuleDirectory}")
if(APPLE)
  unset(ENV{DYLD_LIBRARY_PATH})
endif()

if(TEST_MODE STREQUAL "PREPARE")
  file(REMOVE "${testPythonSelection}")
  # Prefer the configured default, then other built interfaces, then interpreters
  # on this node's PATH. Import checks restrict all candidates to this build.
  set(candidateNames python python3)
  foreach(version IN LISTS testPythonVersions)
    list(APPEND candidateNames "python${version}")
  endforeach()
  foreach(name IN LISTS candidateNames)
    unset(pathPython CACHE)
    find_program(pathPython NAMES "${name}")
    if(pathPython)
      list(APPEND testPythonCandidates "${pathPython}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES testPythonCandidates)
  string(REPLACE ";" "," builtVersions "${testPythonVersions}")
  set(probe "import importlib.util, pathlib, sys; assert '.'.join(map(str, sys.version_info[:2])) in sys.argv[2].split(','), 'Python version has no interface in this build'; spec = importlib.util.find_spec('GUNDAM'); assert spec and spec.origin and pathlib.Path(spec.origin).resolve().parent == pathlib.Path(sys.argv[1]).resolve(), 'No GUNDAM module from this build'; import GUNDAM")
  set(failures "")
  set(selectedPython "")
  foreach(candidate IN LISTS testPythonCandidates)
    if(NOT EXISTS "${candidate}")
      string(APPEND failures "\n  ${candidate}: unavailable on this node")
      continue()
    endif()
    execute_process(COMMAND "${candidate}" -c "${probe}" "${testPythonModuleDirectory}" "${builtVersions}"
      RESULT_VARIABLE probeResult OUTPUT_VARIABLE probeOutput ERROR_VARIABLE probeError TIMEOUT 30)
    if("${probeResult}" STREQUAL "0")
      set(selectedPython "${candidate}")
      break()
    endif()
    string(APPEND failures "\n  ${candidate}: ${probeResult}\n${probeOutput}${probeError}")
  endforeach()
  if(NOT selectedPython)
    message(FATAL_ERROR "No usable Python can import a GUNDAM interface from ${testPythonModuleDirectory}. Built versions: ${testPythonVersions}.${failures}")
  endif()
  list(GET testPythonCandidates 0 preferredPython)
  if(NOT selectedPython STREQUAL preferredPython)
    message(STATUS "Python test fallback: ${preferredPython} -> ${selectedPython}")
  endif()
  message(STATUS "Python tests use ${selectedPython}; modules: ${testPythonModuleDirectory}")
  if(testPythonUseVenv)
    execute_process(COMMAND "${selectedPython}" "${testPythonPrepareScript}" "${testPythonVenv}"
      RESULT_VARIABLE prepareResult)
    if(NOT "${prepareResult}" STREQUAL "0")
      message(FATAL_ERROR "Python test environment preparation failed (${prepareResult}) using ${selectedPython}")
    endif()
    if(WIN32)
      set(selectedPython "${testPythonVenv}/Scripts/python.exe")
    else()
      set(selectedPython "${testPythonVenv}/bin/python")
    endif()
    execute_process(COMMAND "${selectedPython}" -c "${probe}" "${testPythonModuleDirectory}" "${builtVersions}"
      RESULT_VARIABLE venvResult)
    if(NOT "${venvResult}" STREQUAL "0")
      message(FATAL_ERROR "Prepared venv cannot import this build's GUNDAM module: ${selectedPython}")
    endif()
  endif()
  file(WRITE "${testPythonSelection}.tmp" "set(selectedPython [==[${selectedPython}]==])\n")
  file(RENAME "${testPythonSelection}.tmp" "${testPythonSelection}")
elseif(TEST_MODE STREQUAL "RUN")
  if(NOT EXISTS "${testPythonSelection}")
    message(FATAL_ERROR "Python test selection is missing; run the gundam-python-prepare fixture first")
  endif()
  include("${testPythonSelection}")
  execute_process(COMMAND "${selectedPython}" "${testPythonRunner}"
      --suite "${TEST_SUITE}" --test "${TEST_NAME}" RESULT_VARIABLE testResult)
  if(NOT "${testResult}" STREQUAL "0")
    message(FATAL_ERROR "Python test ${TEST_NAME} failed (${testResult}) using ${selectedPython}")
  endif()
else()
  message(FATAL_ERROR "Unknown Python test launcher mode: ${TEST_MODE}")
endif()
